<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CorreoCertificadoPantalla"
    android:background="@drawable/fondo4">

    <EditText
        android:id="@+id/tvRemitente2"
        style="@style/EditTextsBase"
        android:inputType="text"
        android:hint="Remitente"
        android:layout_marginTop="230dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/tvDestino2"
        style="@style/EditTextsBase.EditTexts"
        android:inputType="text"
        android:hint="Destino"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRemitente2" />

    <Spinner
        android:id="@+id/spinnerTamanio"
        android:layout_width="324dp"
        android:layout_height="31dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDestino2" />

    <Button
        android:id="@+id/btnEnviar2"
        style="@style/BotonBase.Enviar"
        android:onClick="onClickEnviar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDestino2" />

    <Button
        android:id="@+id/btnCancelar2"
        style="@style/BotonBase.Cancelar"
        android:onClick="onClickCancelar"
        app:layout_constraintStart_toEndOf="@+id/btnEnviar2"
        app:layout_constraintTop_toBottomOf="@+id/tvDestino2" />

    <ImageButton
        android:id="@+id/imageButton"
        style="@style/ImgAtras"
        android:background="@android:color/transparent"
        android:onClick="onClickAtras" />

    <TextView
        android:id="@+id/tvTitulo"
        android:text="Envío Certificado"
        style="@style/TitulosPantallas"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="10dp"
        app:strokeWidth="5dp"
        android:backgroundTint="@color/white"
        app:strokeColor="@color/marroncito"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tituloCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título"
                android:textSize="20sp"
                android:fontFamily="@font/titulo2"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/descripcionCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="15sp"
                android:fontFamily="@font/letra"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>
