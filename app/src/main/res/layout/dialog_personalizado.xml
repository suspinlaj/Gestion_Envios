<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/marron"
    app:strokeWidth="5dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white">


        <TextView
            android:id="@+id/tvTituloDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/titulo1"
            android:textSize="22sp"
            android:textColor="@color/marron"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMensaje"
            android:fontFamily="@font/titulo2"
            android:layout_marginStart="10dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/grisOscuro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mensaje\nError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAceptar"
            android:backgroundTint="@color/marroncito"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="15dp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/marron"
            app:strokeWidth="3dp"
            android:fontFamily="@font/titulo2"
            android:layout_gravity="end"
            android:text="volver" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
